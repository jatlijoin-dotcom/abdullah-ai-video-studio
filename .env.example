# Abdullah AI Video Studio — environment configuration
# Copy this file to `.env` and fill in the values you actually have.
# NEVER commit a real `.env` file. API keys live ONLY here, never in code
# and never in the frontend.

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Storage ---
# SQLite database file and all uploaded / generated files live under here.
DATABASE_PATH=./storage/studio.db
STORAGE_PATH=./storage

# Full path to the ffmpeg binary (leave empty to use `ffmpeg` from PATH).
FFMPEG_PATH=
FFPROBE_PATH=

# --- Demo mode ---
# true (default): no AI provider is required. The backend generates a real
# storyboard + scene prompts and returns them as a downloadable plan.
# It NEVER returns a fake video. Set false only when a provider key below
# is configured and you want real clip generation.
DEMO_MODE=true

# --- AI video providers (one is enough to generate real clips) ---
# DEFAULT PROVIDER: Gemini Omni Flash via the Gemini API.
# Get a key at https://aistudio.google.com/ (Google AI Studio).
# PAID TIER ONLY — no free tier. Omni output video: 720p ~$0.07/s,
# 1080p (upsampled) ~$0.104/s, 4K (upsampled) ~$0.209/s.
# Verify the current rate: https://ai.google.dev/gemini-api/docs/pricing
GOOGLE_GEMINI_API_KEY=
# Model (default gemini-omni-1.2-flash). Do NOT use a veo-*-preview model —
# the Veo 3.1 Preview models were shut down on the Gemini API on Oct 22, 2026.
OMNI_MODEL=gemini-omni-1.2-flash

# Google Veo 3.1 GA on Google Cloud / Vertex AI (needs a Cloud project,
# billing, a service account and a GCS bucket for output).
# Docs: https://cloud.google.com/vertex-ai/generative-ai/docs/video/generate-videos-from-an-image
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
VEO_GA_MODEL=veo-3.1-generate-001
VEO_GA_GCS_BUCKET=

# Runway Gen-4 — https://dev.runwayml.com/ (paid, credit-based)
# gen4.5: 12 credits/s (~$0.12/s, text + image); gen4_turbo: 5 credits/s
# (~$0.05/s, image only). Default is automatic.
RUNWAY_API_KEY=
# RUNWAY_MODEL=gen4.5   (optional override)

# Kling 4.0 (new official API) — https://kling.ai/dev (paid, credit-based)
# The old KLING_ACCESS_KEY / KLING_SECRET_KEY (legacy JWT API) are obsolete.
KLING_API_KEY=
# KLING_MODEL=kling-4.0   (default; kling-4.0-flash also available)

# Luma Dream Machine (Ray 2) — https://lumalabs.ai/ (paid, credit-based)
LUMA_API_KEY=

# Default provider when several are configured: omni | veo-ga | runway | kling | luma
DEFAULT_PROVIDER=omni

# --- Voice-over (optional) ---
# Every character gets its OWN voice. Set voice_provider + voice_id on the
# character profile (POST /api/characters), and the narrator voice in
# settings (narrator_voice_provider / narrator_voice_id).
# ElevenLabs — https://elevenlabs.io/ (paid; free tier 10,000 credits/month,
# ~10 min of audio, NO commercial licence on the free tier)
ELEVENLABS_API_KEY=
# Google Cloud Text-to-Speech — https://cloud.google.com/text-to-speech
# (API key; restricted key recommended. Free tier: 1M Neural2/WaveNet
# characters/month, billing account required.)
# NOTE: Google TTS offers Urdu ONLY as ur-IN — there is NO ur-PK locale.
# Urdu voices: ur-IN-Standard-A/B, ur-IN-Wavenet-A/B.
GOOGLE_TTS_API_KEY=

# --- Worker ---
# Background job processing. Set false to disable the in-process worker
# (jobs stay queued until a worker runs).
WORKER_ENABLED=true
WORKER_POLL_MS=5000

# --- Upload limits ---
MAX_UPLOAD_MB=20
